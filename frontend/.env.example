# Development: Vite proxies /api to backend (see vite.config.js)
# Production: Set to your Render backend URL
VITE_API_URL=http://localhost:5001/api

# Socket.IO server URL (same as backend in dev)
VITE_SOCKET_URL=http://localhost:5001

# Fine rate displayed in admin Settings (backend FINE_PER_DAY controls actual charge)
VITE_FINE_RATE_PER_DAY=5

# App version shown in Settings page
VITE_APP_VERSION=1.0.0
