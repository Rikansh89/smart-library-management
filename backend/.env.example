# Database Configuration
# Option A: Individual credentials (local/self-hosted)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=smart_library
DB_PORT=3306
DB_SSL=false

# Option B: Single connection URI (Aiven, ClearDB, PlanetScale, etc.)
# Paste the full MYSQL_URI from Aiven Console > Overview > Connection information.
# When MYSQL_URL/DATABASE_URL is set, DB_SSL is forced ON automatically.
MYSQL_URL=
# DATABASE_URL=

# Migration (one-time, only used by `npm run migrate:db`)
SOURCE_MYSQL_URL=mysql://user:pass@old-host:port/db_name
DEST_MYSQL_URL=mysql://avnadmin:pass@smart-library-xxxx.aivencloud.com:port/defaultdb

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Server
PORT=5001
NODE_ENV=development

# Client URL (for CORS and password reset links)
CLIENT_URL=http://localhost:5173

# Email Configuration (optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@smartlibrary.com

# Gemini AI (optional - for chatbot)
GEMINI_API_KEY=your-gemini-api-key

# Fine Configuration
FINE_PER_DAY=5
